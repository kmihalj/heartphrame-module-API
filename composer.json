{
    "name": "aaieduhr/heartphrame-module-api",
    "description": "Versioned, modular HTTP API for HeartPhrame applications.",
    "type": "heartphrame-module",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-framework.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-orm.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-auth.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-menu.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "aaieduhr/heartphrame-framework": "dev-main",
        "aaieduhr/heartphrame-module-auth": "dev-main",
        "aaieduhr/heartphrame-module-orm": "dev-main"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10 || ^11",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3",
        "slevomat/coding-standard": "^8"
    },
    "suggest": {
        "aaieduhr/heartphrame-module-backup": "Adds encrypted backup and restore for API key requests and webhook subscriptions; transient delivery state is excluded.",
        "aaieduhr/heartphrame-module-menu": "Adds API-key administration to configurable settings navigation.",
        "aaieduhr/heartphrame-module-notification": "Notifies administrators and requesters during the optional API-key approval workflow.",
        "aaieduhr/heartphrame-module-theme": "Applies configured light and dark visual tokens to API-key administration screens."
    },
    "autoload": {
        "psr-4": {
            "AaiEduHr\\HeartPhrameModuleApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AaiEduHr\\HeartPhrameModuleApi\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Srce",
            "email": "aai@srce.hr"
        }
    ],
    "config": {
        "github-protocols": [
            "https"
        ],
        "use-github-api": false,
        "sort-packages": true,
        "cache-dir": "build/composer",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "composer-runtime-api": "^2.1"
    },
    "scripts": {
        "pre-commit": [
            "vendor/bin/phpcbf",
            "vendor/bin/rector --clear-cache",
            "vendor/bin/phpcs -p",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ],
        "on-commit": [
            "vendor/bin/phpcs -p",
            "vendor/bin/rector --dry-run --clear-cache",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ]
    }
}
