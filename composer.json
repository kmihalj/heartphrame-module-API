{
    "name": "aaieduhr/heartphrame-module-api",
    "description": "Versioned, modular HTTP API for HeartPhrame applications.",
    "type": "heartphrame-module",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-framework.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-orm.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-auth.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-calendar.git"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.opencode.hr/srce/aai-eduhr/heartphrame/heartphrame-module-html-editor.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-notification.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-task.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kmihalj/heartphrame-module-workspace.git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "aaieduhr/heartphrame-framework": "dev-main",
        "aaieduhr/heartphrame-module-auth": "dev-main",
        "aaieduhr/heartphrame-module-orm": "dev-main"
    },
    "require-dev": {
        "aaieduhr/heartphrame-module-calendar": "dev-main",
        "aaieduhr/heartphrame-module-editor-html": "dev-main",
        "aaieduhr/heartphrame-module-notification": "dev-main",
        "aaieduhr/heartphrame-module-task": "dev-main",
        "aaieduhr/heartphrame-module-workspace": "dev-main",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10 || ^11",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3",
        "slevomat/coding-standard": "^8"
    },
    "suggest": {
        "aaieduhr/heartphrame-module-calendar": "Exposes ACL-aware calendar, event, and ICS endpoints.",
        "aaieduhr/heartphrame-module-editor-html": "Exposes ACL-aware pages, versions, translations, and attachment endpoints.",
        "aaieduhr/heartphrame-module-notification": "Exposes the API-key owner's notification inbox and read state.",
        "aaieduhr/heartphrame-module-task": "Exposes task state and audit endpoints for published Editor pages.",
        "aaieduhr/heartphrame-module-workspace": "Exposes ACL-aware Workspace resources and tree management endpoints."
    },
    "autoload": {
        "psr-4": {
            "AaiEduHr\\HeartPhrameModuleApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AaiEduHr\\HeartPhrameModuleApi\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Srce",
            "email": "aai@srce.hr"
        }
    ],
    "config": {
        "github-protocols": [
            "https"
        ],
        "use-github-api": false,
        "sort-packages": true,
        "cache-dir": "build/composer",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "composer-runtime-api": "^2.1"
    },
    "scripts": {
        "pre-commit": [
            "vendor/bin/phpcbf",
            "vendor/bin/rector --clear-cache",
            "vendor/bin/phpcs -p",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ],
        "on-commit": [
            "vendor/bin/phpcs -p",
            "vendor/bin/rector --dry-run --clear-cache",
            "vendor/bin/phpstan --memory-limit=1024M",
            "vendor/bin/phpstan analyze -c phpstan-dev.neon --memory-limit=1024M",
            "vendor/bin/phpunit"
        ]
    }
}
